{
  "info": {
    "name": "Hero Ecom — Cart + User Service",
    "description": "Full test coverage for user profile, saved addresses, and cart (add/update/remove/checkout) including failure scenarios.\n\nBefore running:\n1. Run '0. Get JWT Token (Customer)' or '0. Get JWT Token (Admin)' first.\n2. The collection auto-sets {{token}} and {{adminToken}} via the test scripts.\n3. Base URL is http://localhost:7070 (API Gateway).\n4. Keycloak is at http://localhost:9090.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl",       "value": "http://localhost:7070" },
    { "key": "keycloakUrl",   "value": "http://localhost:9090" },
    { "key": "realm",         "value": "hero-ecommerce" },
    { "key": "clientId",      "value": "hero-app" },
    { "key": "token",         "value": "" },
    { "key": "adminToken",    "value": "" },
    { "key": "addressId",     "value": "" },
    { "key": "address2Id",    "value": "" },
    { "key": "cartItemId",    "value": "" }
  ],
  "item": [

    {
      "name": "0. Auth",
      "item": [
        {
          "name": "Get JWT — Customer",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('token', json.access_token);",
              "pm.test('Got customer token', () => pm.expect(json.access_token).to.be.a('string'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id",  "value": "{{clientId}}" },
                { "key": "username",   "value": "testcustomer" },
                { "key": "password",   "value": "Test@1234" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "Get JWT — Admin",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "const json = pm.response.json();",
              "pm.collectionVariables.set('adminToken', json.access_token);",
              "pm.test('Got admin token', () => pm.expect(json.access_token).to.be.a('string'));"
            ]}
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id",  "value": "{{clientId}}" },
                { "key": "username",   "value": "testadmin" },
                { "key": "password",   "value": "Admin@1234" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token"
          }
        },
        {
          "name": "FAIL — No token → 401",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/v1/users"
          }
        }
      ]
    },

    {
      "name": "1. User — Profile",
      "item": [
        {
          "name": "GET /users — get or create profile",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('Has id and email', () => { pm.expect(d.id).to.be.a('number'); pm.expect(d.email).to.be.a('string'); });",
            "pm.test('active=true', () => pm.expect(d.active).to.be.true);"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "GET /users — second call returns same user (idempotent)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('Same user each time', () => pm.expect(pm.response.json().data.email).to.be.a('string'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users"
          }
        },
        {
          "name": "PATCH /users/me — update fullName + phone",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const d = pm.response.json().data;",
            "pm.test('fullName updated', () => pm.expect(d.fullName).to.eql('Saurabh Mishra'));",
            "pm.test('phone updated', () => pm.expect(d.phone).to.eql('9876543210'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Saurabh Mishra\",\n  \"phone\": \"9876543210\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "PATCH /users/me — partial update (phone only)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('phone changed', () => pm.expect(pm.response.json().data.phone).to.eql('8765432109'));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"8765432109\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "FAIL — PATCH /users/me — invalid phone (starts with 5)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"5123456789\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        },
        {
          "name": "FAIL — PATCH /users/me — fullName too long (>100 chars)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me"
          }
        }
      ]
    },

    {
      "name": "2. User — Addresses",
      "item": [
        {
          "name": "POST /users/me/addresses — save first address (auto-default)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "pm.test('isDefault=true (first address)', () => pm.expect(d.isDefault).to.be.true);",
            "pm.collectionVariables.set('addressId', d.id);",
            "pm.test('Has id', () => pm.expect(d.id).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Saurabh Mishra\",\n  \"phone\": \"9876543210\",\n  \"streetLine1\": \"123 MG Road\",\n  \"streetLine2\": \"Near City Mall\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"pincode\": \"400001\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "POST /users/me/addresses — save second address (not default)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const d = pm.response.json().data;",
            "pm.test('isDefault=false (not first)', () => pm.expect(d.isDefault).to.be.false);",
            "pm.collectionVariables.set('address2Id', d.id);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Saurabh Mishra\",\n  \"phone\": \"9876543210\",\n  \"streetLine1\": \"456 Brigade Road\",\n  \"city\": \"Bengaluru\",\n  \"state\": \"Karnataka\",\n  \"pincode\": \"560001\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "POST /users/me/addresses — save with isDefault=true (overrides current default)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('isDefault=true', () => pm.expect(pm.response.json().data.isDefault).to.be.true);"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Saurabh Mishra\",\n  \"phone\": \"9876543210\",\n  \"streetLine1\": \"789 Park Street\",\n  \"city\": \"Kolkata\",\n  \"state\": \"West Bengal\",\n  \"pincode\": \"700016\",\n  \"isDefault\": true\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "GET /users/me/addresses — list all addresses",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const list = pm.response.json().data;",
            "pm.test('Returns array', () => pm.expect(list).to.be.an('array'));",
            "pm.test('Has multiple addresses', () => pm.expect(list.length).to.be.gte(2));",
            "const defaults = list.filter(a => a.isDefault);",
            "pm.test('Exactly one default', () => pm.expect(defaults.length).to.eql(1));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "PATCH /users/me/addresses/:id/default — change default",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('isDefault=true on updated address', () => pm.expect(pm.response.json().data.isDefault).to.be.true);"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users/me/addresses/{{addressId}}/default"
          }
        },
        {
          "name": "DELETE /users/me/addresses/:id — delete non-default address",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users/me/addresses/{{address2Id}}"
          }
        },
        {
          "name": "DELETE /users/me/addresses/:id — delete default (next oldest promoted)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('204 No Content', () => pm.response.to.have.status(204));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users/me/addresses/{{addressId}}"
          }
        },
        {
          "name": "FAIL — POST /users/me/addresses — invalid phone",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test User\",\n  \"phone\": \"1234567890\",\n  \"streetLine1\": \"123 Test St\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\",\n  \"pincode\": \"110001\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "FAIL — POST /users/me/addresses — invalid pincode (starts with 0)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test User\",\n  \"phone\": \"9876543210\",\n  \"streetLine1\": \"123 Test St\",\n  \"city\": \"Delhi\",\n  \"state\": \"Delhi\",\n  \"pincode\": \"012345\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "FAIL — POST /users/me/addresses — missing required fields",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"fullName\": \"Test User\"\n}" },
            "url": "{{baseUrl}}/api/v1/users/me/addresses"
          }
        },
        {
          "name": "FAIL — DELETE address that doesn't exist → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/users/me/addresses/999999"
          }
        }
      ]
    },

    {
      "name": "3. Cart — Add Items",
      "item": [
        {
          "name": "POST /cart/items — add bike (qty 1)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const body = pm.response.json();",
            "pm.test('itemCount >= 1', () => pm.expect(body.itemCount).to.be.gte(1));",
            "pm.test('cartTotal > 0', () => pm.expect(parseFloat(body.cartTotal)).to.be.gt(0));",
            "if (body.items && body.items.length > 0) {",
            "  pm.collectionVariables.set('cartItemId', body.items[0].cartItemId);",
            "}"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 1,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "POST /cart/items — add same bike again (quantity increments)",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "const first = pm.response.json().items.find(i => i.bikeId === 1);",
            "pm.test('qty incremented to 2', () => pm.expect(first.quantity).to.eql(2));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 1,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "POST /cart/items — add second bike",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('201 Created', () => pm.response.to.have.status(201));",
            "pm.test('itemCount is 2', () => pm.expect(pm.response.json().itemCount).to.eql(2));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 2,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "FAIL — Add non-existent bike → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 99999,\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "FAIL — Add with quantity 0 → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 1,\n  \"quantity\": 0\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "FAIL — Add with quantity 11 → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"bikeId\": 1,\n  \"quantity\": 11\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        },
        {
          "name": "FAIL — Add without bikeId → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 1\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items"
          }
        }
      ]
    },

    {
      "name": "4. Cart — View & Update",
      "item": [
        {
          "name": "GET /cart — view current cart",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const body = pm.response.json();",
            "pm.test('Has items array', () => pm.expect(body.items).to.be.an('array'));",
            "pm.test('itemCount matches items length', () => pm.expect(body.itemCount).to.eql(body.items.length));",
            "pm.test('cartTotal is number', () => pm.expect(parseFloat(body.cartTotal)).to.be.a('number'));"
          ]}}],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/v1/cart"
          }
        },
        {
          "name": "PATCH /cart/items/:id — update quantity to 3",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "const updated = pm.response.json().items.find(i => i.cartItemId === parseInt(pm.collectionVariables.get('cartItemId')));",
            "pm.test('Quantity is 3', () => pm.expect(updated.quantity).to.eql(3));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items/{{cartItemId}}"
          }
        },
        {
          "name": "FAIL — PATCH /cart/items/:id — quantity 0 → 400",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('400 Bad Request', () => pm.response.to.have.status(400));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 0\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items/{{cartItemId}}"
          }
        },
        {
          "name": "FAIL — PATCH /cart/items/999999 — not found → 404",
          "event": [{ "listen": "test", "script": { "exec": [
            "pm.test('404 Not Found', () => pm.response.to.have.status(404));"
          ]}}],
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type",  "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 2\n}" },
            "url": "{{baseUrl}}/api/v1/cart/items/999999"
          }
        },
