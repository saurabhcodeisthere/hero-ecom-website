<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.hero</groupId>
        <artifactId>hero-ecom-platform</artifactId>
        <version>1.0.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>common-exception</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>common-exception</name>
    <description>Shared exception handling library for Hero Ecom microservices</description>

    <!--
        lombok and spring-boot-starter-test are inherited from parent — no need to redeclare.
    -->
    <dependencies>

        <!-- Web — provides ResponseEntity, HttpStatus, @RestControllerAdvice etc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- Validation — provides @Valid, MethodArgumentNotValidException etc -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <!--
                    This is a LIBRARY, not an executable app.
                    Override the parent's spring-boot-maven-plugin config
                    and add skip=true so Maven installs a plain JAR (not a fat JAR).
                    Other services can then use it as a <dependency>.
                -->
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
